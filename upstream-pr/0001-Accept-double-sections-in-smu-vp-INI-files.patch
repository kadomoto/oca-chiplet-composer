diff --git a/sw/smu-vp-tests/smu-aou-delay-test/smc_main.c b/sw/smu-vp-tests/smu-aou-delay-test/smc_main.c
new file mode 100644
index 0000000..c3cdf3b
--- /dev/null
+++ b/sw/smu-vp-tests/smu-aou-delay-test/smc_main.c
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* SPDX-FileCopyrightText: 2026 Tenstorrent USA, Inc. */
+/*
+ * SMU AOU bridge-delay test (VP original).
+ *
+ * smc.ini (generated by the Makefile) sets, in a [double] section:
+ *   dut.aou.bridge_delay_ns  = BRIDGE_DELAY_NS   (AXI hop annotated delay)
+ *   dut.clint.tick_period_ns = MTIME_TICK_NS     (smu-vp default 0 = frozen)
+ *
+ * After activating the AOU, the SMC does NBEATS write+readback pairs to a
+ * catch-all address (xbar.ext_out -> local AOU -> peer -> stub_sysmem) and
+ * measures MTIME around them.  Each access crosses the AOU once, so MTIME
+ * must advance by at least 2 * NBEATS * BRIDGE_DELAY_NS.  If smu-vp drops
+ * the [double] section, MTIME stays frozen and the delay is zero: FAIL.
+ *
+ * The cluster steps quantum_insts (default 1000) instructions per kernel
+ * yield and the CLINT reads global time, so annotated delay only shows in
+ * MTIME after the hart syncs.  settle() spins past a batch boundary before
+ * each MTIME read; the spin's own cost is calibrated out.
+ */
+#include "smc_common.h"
+
+extern int printf(const char *fmt, ...);
+
+#define BRIDGE_DELAY_NS         10000u   /* keep in sync with Makefile */
+#define MTIME_TICK_NS           100u     /* keep in sync with Makefile */
+
+#define AOU_INIT                0x08u
+#define AOU_INIT_ACTIVATE_START (1u << 0)
+#define AOU_INIT_STATE_ENABLED  (1u << 2)
+
+#define EXT_ADDR                0xA0002000ULL
+#define NBEATS                  4u
+#define HOPS                    (2u * NBEATS)
+#define PATTERN(i)              (0xDE1A0000u + (i))
+
+#define SETTLE_ITERS            4000u    /* > quantum_insts instructions */
+
+#define REG32(addr)             (*(volatile uint32_t *)(uintptr_t)(addr))
+
+static void settle(void)
+{
+    for (volatile uint32_t i = 0; i < SETTLE_ITERS; ++i) {
+    }
+}
+
+static uint64_t mtime(void)
+{
+    uint32_t hi, lo;
+    do {
+        hi = REG_READ(SMC_CLINT_BASE + CLINT_MTIME_HI);
+        lo = REG_READ(SMC_CLINT_BASE + CLINT_MTIME_LO);
+    } while (hi != REG_READ(SMC_CLINT_BASE + CLINT_MTIME_HI));
+    return ((uint64_t)hi << 32) | lo;
+}
+
+int main(void)
+{
+    printf("\n=== SMU AOU delay test (SMC side) ===\n");
+
+    REG_WRITE(SMC_AOU_BASE + AOU_INIT, AOU_INIT_ACTIVATE_START);
+    const uint32_t init = REG_READ(SMC_AOU_BASE + AOU_INIT);
+    if ((init & AOU_INIT_STATE_ENABLED) == 0) {
+        printf("FAIL: AOU not ENABLED after activate (INIT=0x%x)\n", init);
+        return 1;
+    }
+
+    settle();
+    const uint64_t c0 = mtime();
+    settle();
+    const uint64_t c1 = mtime();
+    const uint64_t spin_ticks = c1 - c0;
+
+    settle();
+    const uint64_t t0 = mtime();
+    for (uint32_t i = 0; i < NBEATS; ++i) {
+        REG32(EXT_ADDR + 4u * i) = PATTERN(i);
+        const uint32_t got = REG32(EXT_ADDR + 4u * i);
+        if (got != PATTERN(i)) {
+            printf("FAIL: beat %u readback 0x%08x want 0x%08x\n", i, got, PATTERN(i));
+            return 1;
+        }
+    }
+    settle();
+    const uint64_t t1 = mtime();
+
+    const uint64_t raw_ticks  = t1 - t0;
+    const uint64_t ticks      = raw_ticks > spin_ticks ? raw_ticks - spin_ticks : 0;
+    const uint64_t elapsed_ns = ticks * MTIME_TICK_NS;
+    const uint64_t min_ns     = (uint64_t)HOPS * BRIDGE_DELAY_NS;
+    printf("AOU: %u hops, MTIME delta %u ticks (spin %u) = %u ns (min %u ns), %u ns/hop\n",
+           HOPS, (uint32_t)raw_ticks, (uint32_t)spin_ticks, (uint32_t)elapsed_ns,
+           (uint32_t)min_ns, (uint32_t)(elapsed_ns / HOPS));
+    if (elapsed_ns < min_ns) {
+        printf("FAIL: AOU bridge_delay_ns not applied (%u ns < %u ns)\n",
+               (uint32_t)elapsed_ns, (uint32_t)min_ns);
+        return 1;
+    }
+
+    printf("PASS: SMU AOU delay test (SMC side)\n");
+    return 0;
+}
